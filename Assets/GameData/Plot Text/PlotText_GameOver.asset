  m_Name: PlotText_GameOver
  m_EditorClassIdentifier: 
  plotText: "\u5200\u5251\u6CDB\u7740\u51CC\u51BD\u7684\u5BD2\u5149\uFF0C\n\u5F53\u52C7\u8005\u7684\u957F\u5251\u62B5\u4F4F\u5BF9\u65B9\u7684\u4E0B\u989A\u65F6\uFF0C\n\u5979\u624D\u53D1\u89C9\u5148\u524D\u7684\u81EA\u5DF1\uFF0C\n\u662F\u591A\u4E48\u65E0\u77E5\u3001\u5E7C\u7A1A......\n\u662F\u554A\uFF0C\n\u5728\u8FD9\u4F4D\u82F1\u660E\u795E\u6B66\u7684\u52C7\u8005\u9762\u524D\uFF0C\n\u4E00\u5207\u9634\u8C0B\u8BE1\u8BA1\u90FD\u50CF\u662F\u4E2A\u7B11\u8BDD\uFF0C\n\u5979\u5C06\u5B9D\u5251\u53CC\u624B\u5949\u4E0A\uFF0C\n\u5FC3\u91CC\u8FD9\u822C\u60F3\u7740\uFF0C\n\n\u4E8E\u662F\u4E4E\uFF0C\n\u5979\u88AB\u52C7\u8005\u7684\u82F1\u52C7\u65E0\u754F\u6240\u6298\u670D\u4E86\uFF0C\n\u6700\u540E\uFF0C\u5979\u4EEC\u4E24\u4E2A\u8FC7\u4E0A\u6CA1\u7F9E\u6CA1\u81CA\u7684\u5E78\u798F\u751F\u6D3B\uFF0C\n\u5728\u6076\u9F99\u610F\u5473\u6DF1\u957F\u7684\u6CE8\u89C6\u4E4B\u4E0B\n"
