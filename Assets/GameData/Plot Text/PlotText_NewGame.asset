  m_Name: PlotText_NewGame
  m_EditorClassIdentifier: 
  plotText: "\u5982\u5F80\u5E38\u822C\u5728\u98CE\u548C\u65E5\u4E3D\u7684\u4E00\u5929\uFF0C\n\u54C8\u57FA\u7C73\u738B\u56FD\u8FCE\u6765\u4E86\u4E00\u4F4D\u4E0D\u901F\u4E4B\u5BA2\n\u2014\u2014\u9ED1\u9F99\u738B\uFF01\n\n\n\u5728\u738B\u56FD\u9A91\u58EB\u56E2\u7684\u4E0D\u61C8\u52AA\u529B\u4E0B\uFF0C\n\u90AA\u6076\u7684\u9ED1\u9F99\u738B\u7EC8\u4E8E\u88AB\u8D76\u8DD1\u3002\n\u4F46\u4E0D\u5E78\u7684\u662F\uFF0C\n\u738B\u56FD\u5723\u5251\u5374\u4E0D\u5E78\u5931\u7A83\u2026\u2026\n"
